# FastAPI backend — query-only by default (retrieval + answering + conversational), so it
# stays small (no browser/OCR). To also serve the Step 1 crawl offload (POST /crawl), build a
# crawl-capable image: install the backend's [crawl] extra and add Chromium + Tesseract like
# the frontend Dockerfile (plus `playwright install --with-deps chromium` + `crawl4ai-setup`).
# Crawl offload also needs frontend+backend to share storage (ARTIFACTS_ROOT == SESSIONS_ROOT).
#   docker build -f Dockerfile.backend -t rag-playground-backend .
#   docker run -p 8000:8000 -v app-data:/data/sessions \
#     -e ARTIFACTS_ROOT=/data/sessions rag-playground-backend
FROM python:3.14-slim-bookworm

ENV PYTHONUNBUFFERED=1 \
    PYTHONDONTWRITEBYTECODE=1 \
    ANONYMIZED_TELEMETRY=False \
    PIP_NO_CACHE_DIR=1

WORKDIR /app
COPY . .

# The API serves retrieval + answering, so it needs the rag + vector libraries, a
# model provider (bedrock/openai), and the [s3] backend for shared object storage.
RUN pip install --upgrade pip \
    && pip install -e '.[rag,vector,bedrock,openai,s3]' -e 'apps/backend'

EXPOSE 8000
CMD ["uvicorn", "app_backend.main:app", "--host", "0.0.0.0", "--port", "8000"]
